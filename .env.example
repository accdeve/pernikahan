# ============================================================
# Environment — satu file untuk semua service (Template)
# Root docker-compose.yml (include + web) dan supabase/supabase.yml
# sama-sama referensi file ini via `env_file: .env`
# ============================================================

############
# Node / App
############
NODE_ENV=development

############
# Supabase API (Vite client — hanya VITE_ prefix yg ke bundle)
############
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

############
# Secrets — CHANGE BEFORE PRODUCTION
############

# Postgres superuser password
POSTGRES_PASSWORD=your-postgres-password

# JWT secret (must be >= 32 chars)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Legacy HS256 API keys (signed with JWT_SECRET above)
ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# Asymmetric JWT keys — leave empty for HS256 mode
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# Realtime & Supavisor
SECRET_KEY_BASE=your-secret-key-base-at-least-64-chars-long
VAULT_ENC_KEY=your-vault-enc-key-32-chars-long

# Studio postgres-meta
PG_META_CRYPTO_KEY=your-pg-meta-crypto-key-32-chars-long

# Analytics
LOGFLARE_PUBLIC_ACCESS_TOKEN=logflare-public-token-dev
LOGFLARE_PRIVATE_ACCESS_TOKEN=logflare-private-token-dev

############
# Dashboard
############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=supabase-admin

############
# URLs
############
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Supavisor (connection pooler)
############
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=local-dev-tenant
POOLER_DB_POOL_SIZE=5

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Pernikahan
STUDIO_DEFAULT_PROJECT=Wedding Invitation
OPENAI_API_KEY=

############
# Auth (GoTrue)
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

# Google OAuth
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOTRUE_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback

############
# Storage (Supabase internal — S3 protocol access key)
############
S3_PROTOCOL_ACCESS_KEY_ID=your-supabase-s3-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=your-supabase-s3-access-key-secret
IMGPROXY_AUTO_WEBP=true

############
# S3 Storage (admin uploads — external S3-compatible)
############
S3_SERVER_URL=your-external-s3-server-url
S3_ACCESS_KEY_ID=your-external-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-external-s3-secret-access-key
S3_BUCKET_NAME=your-external-s3-bucket-name
S3_REGION=your-external-s3-region

############
# Functions (Edge Functions)
############
FUNCTIONS_VERIFY_JWT=false
OTP_WEBHOOK_SECRET=your-otp-webhook-secret
OTP_WEBHOOK_URL=your-otp-webhook-url

############
# API (PostgREST)
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# API Gateway (Kong)
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Redis
############
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_LOGLEVEL=notice
